struct SearchResultItem {
    name: string,
    path: string,
    size: string,
    modified: string,
    is_directory: bool,
}

export component SearchBar inherits Window {
    in property <string> placeholder: "Search files...";
    in property <string> hotkey_hint: "Alt+Space";

    // Theme colors
    in property <brush> bg_color: #fafafa;
    in property <brush> text_color: #1a1a1a;
    in property <brush> accent_color: #0078d4;
    in property <brush> border_color: #e0e0e0;

    // Search state
    property <string> search_text: "";
    in property <int> results_count: 0;
    in property <bool> searching: false;
    in property <string> status_text: "";

    // Search results model - populated from Rust
    in property <[SearchResultItem]> search_results: [];

    callback search_requested(string);
    callback result_selected(string);
    callback hotkey_pressed();
    callback escape_pressed();

    preferred-width: 640px;
    preferred-height: 480px;

    background: bg_color;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: bg_color;
        border-width: 1px;
        border-color: border_color;
        border-radius: 8px;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            padding: 12px;

            // Search input row
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: transparent;
                    Text { text: "🔍"; font-size: 18px; color: #666; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: parent.width - 72px;
                    height: 32px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: border_color;
                    border-radius: 4px;
                    TextInput {
                        x: 4px; y: 0; width: parent.width - 8px; height: 32px;
                        text: search_text; font-size: 16px; color: text_color;
                        horizontal-alignment: left; vertical-alignment: center;
                        edited => { search_requested(self.text); }
                    }
                }
                TouchArea {
                    width: 32px; height: 32px; visible: search_text != "";
                    clicked => { search_text = ""; search_requested(""); }
                    Rectangle { width: 32px; height: 32px; background: transparent;
                        Text { text: "✕"; font-size: 16px; color: #666; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // RESULTS PANEL - RUST-GENERATED RESULTS VIA FOR LOOP
            Rectangle {
                width: parent.width;
                height: 320px;
                background: #ffffff;
                border-width: 2px;
                border-color: border_color;
                border-radius: 4px;
                clip: false;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0;
                    padding: 0;

                    // Results from Rust model - rendered via for loop
                    for item in search_results : Rectangle {
                        width: parent.width;
                        height: 50px;
                        background: #f8f9fa;
                        border-width: 1px;
                        border-color: #e8e8e8;

                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 12px;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;

                            // File type icon
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                background: item.is_directory ? accent_color : #6c757d;
                                border-radius: 4px;
                                Text {
                                    text: item.is_directory ? "📁" : "📄";
                                    font-size: 16px;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // File info
                            VerticalLayout {
                                width: parent.width - 56px;
                                spacing: 2px;
                                Text {
                                    text: item.name;
                                    font-size: 14px;
                                    color: text_color;
                                    font-weight: 500;
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    Text {
                                        text: item.size;
                                        font-size: 12px;
                                        color: #888;
                                    }
                                    Text {
                                        text: item.modified;
                                        font-size: 12px;
                                        color: #888;
                                    }
                                }
                            }

                            // Click area
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.result_selected(item.path);
                                }
                            }
                        }
                    }
                }
            }

            // Preview pane - hidden for debugging
            Rectangle {
                visible: false;
                height: 0;
            }

            // Status bar
            HorizontalLayout {
                spacing: 12px;
                Text { text: status_text; font-size: 12px; color: #888; }
                Text { text: "Alt+Space to open | Esc to close"; font-size: 11px; color: #aaa; }
            }
        }
    }
}
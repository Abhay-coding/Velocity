struct SearchResultItem {
    name: string,
    path: string,
    size: string,
    modified: string,
    is_directory: bool,
}

export component SearchBar inherits Window {
    in property <string> placeholder: "Search files...";
    in property <string> hotkey_hint: "Alt+Space";

    // Theme colors
    in property <brush> bg_color: #fafafa;
    in property <brush> text_color: #1a1a1a;
    in property <brush> accent_color: #0078d4;
    in property <brush> border_color: #e0e0e0;

    // Search state
    property <string> search_text: "";
    in property <int> results_count: 0;
    in property <bool> searching: false;
    in property <string> status_text: "";

    // Selection state for keyboard navigation
    in-out property <string> selected_path: "";
    property <int> selected_index: -1;

    // Search results model - populated from Rust
    in property <[SearchResultItem]> search_results: [];
    changed search_results => { selected_index = -1; selected_path = ""; }

    callback search_requested(string);
    callback result_selected(string);
    callback result_opened(string);
    callback result_opened_folder(string);
    callback hotkey_pressed();
    callback escape_pressed();
    callback selection_changed(string);
    callback key_up_pressed();
    callback key_down_pressed();
    callback key_enter_pressed();
    callback key_ctrl_enter_pressed();

    preferred-width: 640px;
    preferred-height: 480px;

    background: bg_color;
    init => { input.focus(); }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: bg_color;
        border-width: 1px;
        border-color: border_color;
        border-radius: 8px;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            padding: 12px;

            // Search input row
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: transparent;
                    Text { text: "🔍"; font-size: 18px; color: #666; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: parent.width - 72px;
                    height: 32px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: border_color;
                    border-radius: 4px;
                    input := TextInput {
                        x: 4px; y: 0; width: parent.width - 8px; height: 32px;
                        text <=> search_text; font-size: 16px; color: text_color;
                        horizontal-alignment: left; vertical-alignment: center;
                        edited => { selected_index = -1; search_requested(self.text); }
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                escape_pressed();
                                return accept;
                            }
                            if event.text == Key.DownArrow && search_results.length > 0 {
                                selected_index = Math.min(selected_index + 1, search_results.length - 1);
                                selected_path = search_results[selected_index].path;
                                results_view.content-y = -Math.max(0px, selected_index * 50px - 250px);
                                return accept;
                            }
                            if event.text == Key.UpArrow && search_results.length > 0 {
                                selected_index = Math.max(selected_index - 1, 0);
                                selected_path = search_results[selected_index].path;
                                results_view.content-y = -Math.max(0px, selected_index * 50px - 250px);
                                return accept;
                            }
                            if event.text == Key.Return && search_results.length > 0 {
                                if selected_index < 0 { selected_index = 0; }
                                selected_path = search_results[selected_index].path;
                                if event.modifiers.control { result_opened_folder(selected_path); }
                                else { result_opened(selected_path); }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
                TouchArea {
                    width: 32px; height: 32px; visible: search_text != "";
                    clicked => { search_text = ""; search_requested(""); }
                    Rectangle { width: 32px; height: 32px; background: transparent;
                        Text { text: "✕"; font-size: 16px; color: #666; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // RESULTS PANEL - RUST-GENERATED RESULTS VIA FOR LOOP
            Rectangle {
                width: parent.width;
                height: 320px;
                background: #ffffff;
                border-width: 2px;
                border-color: border_color;
                border-radius: 4px;
                clip: true;

                results_view := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: search_results.length * 50px;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 0;
                        padding: 0;

                        // Results from Rust model - rendered via for loop
                        for item[index] in search_results : Rectangle {
                            width: parent.width;
                            height: 50px;
                            background: item.path == selected_path ? #e3f2fd : #f8f9fa;
                            border-width: 1px;
                            border-color: item.path == selected_path ? accent_color : #e8e8e8;

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 12px;
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                // File type icon
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    background: item.is_directory ? accent_color : #6c757d;
                                    border-radius: 4px;
                                    Text {
                                        text: item.is_directory ? "📁" : "📄";
                                        font-size: 16px;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // File info
                                VerticalLayout {
                                    width: parent.width - 56px;
                                    spacing: 2px;
                                    Text {
                                        text: item.name;
                                        font-size: 14px;
                                        color: item.path == selected_path ? accent_color : text_color;
                                        font-weight: 500;
                                    }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        Text {
                                            text: item.size;
                                            font-size: 12px;
                                            color: #888;
                                        }
                                        Text {
                                            text: item.modified;
                                            font-size: 12px;
                                            color: #888;
                                        }
                                    }
                                }

                                // Click area
                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => {
                                        root.result_selected(item.path);
                                        selected_index = index;
                                        selected_path = item.path;
                                        selection_changed(item.path);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Preview pane - hidden for debugging
            Rectangle {
                visible: false;
                height: 0;
            }

            // Status bar
            HorizontalLayout {
                spacing: 12px;
                Text { text: status_text; font-size: 12px; color: #888; }
                Text { text: "Alt+Space to open | ↑↓ navigate | Enter open | Ctrl+Enter open folder | Esc to close"; font-size: 11px; color: #aaa; }
            }
        }
    }
}